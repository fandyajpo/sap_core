{
  "name": "sap-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "test:v03": "node --test tests/v03-better-auth.integration.test.mjs",
    "test:d6": "node --test tests/d6-scoped-access.integration.test.mjs",
    "test:d7": "node --test tests/d7-role-assignment.integration.test.mjs",
    "test:d8": "node --test tests/d8-role-definition.integration.test.mjs",
    "test:d1": "node --test tests/d1-organization-slot.integration.test.mjs",
    "test:tenant-context": "node --test tests/tenant-context.unit.test.mjs",
    "test:authorization-policy": "node --test tests/authorization-policy.unit.test.mjs",
    "test:tenant-target-context": "node --test tests/tenant-target-context.unit.test.mjs"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.17",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.17",
    "next": "16.4.5",
    "pg": "8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.5",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  }
}
