generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["core", "master_data", "procurement", "inventory", "sales", "finance", "production", "human_resources", "integration", "system"]
}

// Minimal technical-validation model only. This is not the production entity catalog.
model ValidationRecord {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  references ValidationReference[]

  @@map("validation_records")
  @@schema("core")
}

model ValidationReference {
  id                 String           @id @default(uuid()) @db.Uuid
  validationRecordId String           @map("validation_record_id") @db.Uuid
  validationRecord   ValidationRecord @relation(fields: [validationRecordId], references: [id], onDelete: Cascade)
  label              String           @db.VarChar(120)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([validationRecordId])
  @@map("validation_references")
  @@schema("master_data")
}


// Better Auth 1.7.17 core persistence. These remain authentication identities,
// not ERP roles, memberships, or HR employee records.
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
  @@schema("core")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([token])
  @@index([userId])
  @@map("session")
  @@schema("core")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("account")
  @@schema("core")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("core")
}
