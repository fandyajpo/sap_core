generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["core", "master_data", "procurement", "inventory", "sales", "finance", "production", "human_resources", "integration", "system"]
}

enum OrganizationMembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  ENDED

  @@schema("core")
}

enum ScopedAccessStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  ENDED

  @@schema("core")
}

enum RoleDefinitionKind {
  SYSTEM
  ORGANIZATION_CUSTOM

  @@schema("core")
}

enum RoleScope {
  ORGANIZATION
  COMPANY
  PLANT
  PLATFORM

  @@schema("core")
}

enum PermissionGrantEffect {
  ALLOW
  DENY

  @@schema("core")
}

// Minimal technical-validation model only. This is not the production entity catalog.
model ValidationRecord {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  references ValidationReference[]

  @@map("validation_records")
  @@schema("core")
}

model ValidationReference {
  id                 String           @id @default(uuid()) @db.Uuid
  validationRecordId String           @map("validation_record_id") @db.Uuid
  validationRecord   ValidationRecord @relation(fields: [validationRecordId], references: [id], onDelete: Cascade)
  label              String           @db.VarChar(120)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([validationRecordId])
  @@map("validation_references")
  @@schema("master_data")
}

// Better Auth 1.7.17 core persistence. These remain authentication identities,
// not ERP roles, memberships, or HR employee records.
model User {
  id                      String                   @id
  name                    String
  email                   String
  emailVerified           Boolean                  @default(false)
  image                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                Session[]
  accounts                Account[]
  organizationMemberships OrganizationMembership[]
  companyMemberships      CompanyMembership[]
  plantAssignments        PlantAssignment[]
  issuedTenantDenyPolicies TenantDenyPolicy[] @relation("TenantDenyPolicyIssuer")
  revokedTenantDenyPolicies TenantDenyPolicy[] @relation("TenantDenyPolicyRevoker")
  tenantDenyAuditEvents TenantDenyAuditEvent[] @relation("TenantDenyAuditActor")

  @@unique([email])
  @@map("user")
  @@schema("core")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([token])
  @@index([userId])
  @@map("session")
  @@schema("core")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@map("account")
  @@schema("core")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("core")
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  companies   Company[]
  memberships OrganizationMembership[]

  @@map("organization")
  @@schema("core")
}

model Company {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  plants         Plant[]             @relation("CompanyPlants")
  memberships    CompanyMembership[] @relation("CompanyMemberships")
  tenantDenyPolicies TenantDenyPolicy[] @relation("TenantDenyPolicyCompany")

  // Composite target required for X02 and X04 references; id remains the primary key.
  @@unique([organizationId, id], map: "company_organization_id_id_key")
  @@index([organizationId])
  @@map("company")
  @@schema("core")
}

model Plant {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  companyId      String            @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  company        Company           @relation("CompanyPlants", fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  assignments    PlantAssignment[]
  tenantDenyPolicies TenantDenyPolicy[] @relation("TenantDenyPolicyPlant")
  tenantDenyPolicies TenantDenyPolicy[] @relation("TenantDenyPolicyPlant")

  // Composite target required for the X05 Plant reference; id remains the primary key.
  @@unique([organizationId, companyId, id], map: "plant_organization_company_id_key")
  @@index([organizationId, companyId])
  @@map("plant")
  @@schema("core")
}

model OrganizationMembership {
  id                 String                       @id @default(uuid()) @db.Uuid
  userId             String
  organizationId     String                       @db.Uuid
  status             OrganizationMembershipStatus
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User                         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  companyMemberships CompanyMembership[]
  roleAssignments    OrganizationRoleAssignment[]
  tenantDenyPolicies TenantDenyPolicy[]

  // Composite target required for the X04 OrganizationMembership reference.
  @@unique([id, userId, organizationId], map: "organization_membership_id_user_org_key")
  @@unique([userId], where: raw("status IN ('ACTIVE','SUSPENDED')"), map: "organization_membership_user_slot_key")
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("organization_membership")
  @@schema("core")
}

model CompanyMembership {
  id                       String                  @id @default(uuid()) @db.Uuid
  userId                   String
  organizationMembershipId String                  @db.Uuid
  organizationId           String                  @db.Uuid
  companyId                String                  @db.Uuid
  status                   ScopedAccessStatus
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organizationMembership   OrganizationMembership  @relation(fields: [organizationMembershipId, userId, organizationId], references: [id, userId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  company                  Company                 @relation("CompanyMemberships", fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  plantAssignments         PlantAssignment[]
  roleAssignments          CompanyRoleAssignment[]

  // Composite target required for the X05 CompanyMembership reference.
  @@unique([id, userId, organizationId, companyId], map: "company_membership_id_user_org_company_key")
  @@unique([userId, companyId], where: raw("status IN ('ACTIVE','SUSPENDED')"), map: "company_membership_user_company_current_key")
  @@index([userId, status])
  @@index([organizationMembershipId, userId, organizationId])
  @@index([organizationId, companyId])
  @@map("company_membership")
  @@schema("core")
}

model PlantAssignment {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String
  companyMembershipId String                @db.Uuid
  organizationId      String                @db.Uuid
  companyId           String                @db.Uuid
  plantId             String                @db.Uuid
  status              ScopedAccessStatus
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  companyMembership   CompanyMembership     @relation(fields: [companyMembershipId, userId, organizationId, companyId], references: [id, userId, organizationId, companyId], onDelete: Restrict, onUpdate: Restrict)
  plant               Plant                 @relation(fields: [organizationId, companyId, plantId], references: [organizationId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  roleAssignments     PlantRoleAssignment[]

  @@unique([userId, plantId], where: raw("status IN ('ACTIVE','SUSPENDED')"), map: "plant_assignment_user_plant_current_key")
  @@index([userId, status])
  @@index([companyMembershipId, userId, organizationId, companyId])
  @@index([organizationId, companyId, plantId])
  @@map("plant_assignment")
  @@schema("core")
}

// Tenant Role Definitions own immutable, sealed permission snapshots.
model RoleDefinition {
  id                      String                       @id @default(uuid()) @db.Uuid
  roleFamilyId            String?                      @map("role_family_id") @db.Uuid
  code                    String
  version                 Int
  kind                    RoleDefinitionKind
  scope                   RoleScope
  ownerOrganizationId     String?                      @db.Uuid
  disabledAt              DateTime?                    @map("disabled_at") @db.Timestamptz(6)
  permissionsLockedAt     DateTime?                    @map("permissions_locked_at") @db.Timestamptz(6)
  createdAt               DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organizationAssignments OrganizationRoleAssignment[]
  companyAssignments      CompanyRoleAssignment[]
  plantAssignments        PlantRoleAssignment[]
  permissionGrants        RolePermissionGrant[]

  // Typed assignment matching, family version identity, and sealed permission snapshots.
  @@unique([id, scope], map: "role_definition_id_scope_key")
  @@unique([roleFamilyId, version], map: "role_definition_role_family_version_key")
  @@unique([scope, code], where: raw("kind = 'SYSTEM'"), map: "role_definition_system_scope_code_key")
  @@index([ownerOrganizationId])
  @@map("role_definition")
  @@schema("core")
}

model PermissionDelegationPolicy {
  permissionDefinitionId String               @id @map("permission_definition_id") @db.Uuid
  permissionDefinition   PermissionDefinition @relation(fields: [permissionDefinitionId], references: [id], onDelete: Restrict)
  isDelegable            Boolean              @default(false) @map("is_delegable")
  approvedAt             DateTime?            @map("approved_at") @db.Timestamptz(6)
  approvedBy             String?              @map("approved_by")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("permission_delegation_policy")
  @@schema("core")
}

model PermissionDefinition {
  id          String                @id @default(uuid()) @db.Uuid
  code        String                @unique
  description String                @db.Text
  delegationPolicy PermissionDelegationPolicy?
  tenantDenyPolicies TenantDenyPolicy[]
  tenantDenyAuditEvents TenantDenyAuditEvent[]
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  grants      RolePermissionGrant[]

  @@map("permission_definition")
  @@schema("core")
}

model RolePermissionGrant {
  id                   String                @id @default(uuid()) @db.Uuid
  roleDefinitionId     String                @map("role_definition_id") @db.Uuid
  permissionDefinitionId String              @map("permission_definition_id") @db.Uuid
  effect               PermissionGrantEffect
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  roleDefinition       RoleDefinition        @relation(fields: [roleDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissionDefinition PermissionDefinition  @relation(fields: [permissionDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([roleDefinitionId, permissionDefinitionId], map: "role_permission_grant_role_permission_key")
  @@index([roleDefinitionId])
  @@index([permissionDefinitionId])
  @@map("role_permission_grant")
  @@schema("core")
}

model RoleDefinitionAudit {
  id                   String    @id @default(uuid()) @db.Uuid
  roleFamilyId         String    @map("role_family_id") @db.Uuid
  roleDefinitionId     String    @map("role_definition_id") @db.Uuid
  ownerOrganizationId  String    @map("owner_organization_id") @db.Uuid
  actorUserId          String    @map("actor_user_id")
  eventType            String    @map("event_type") @db.VarChar(8)
  version              Int
  code                 String
  scope                RoleScope
  occurredAt           DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([ownerOrganizationId, occurredAt])
  @@index([roleFamilyId, version])
  @@map("role_definition_audit")
  @@schema("core")
}

model OrganizationRoleAssignment {
  id                       String                 @id @default(uuid()) @db.Uuid
  organizationMembershipId String                 @db.Uuid
  roleDefinitionId         String                 @db.Uuid
  roleScope                RoleScope              @default(ORGANIZATION) @map("role_scope")
  grantActorUserId         String?                @map("grant_actor_user_id")
  isBreakGlass             Boolean                @default(false) @map("is_break_glass")
  breakGlassReason         String?                @map("break_glass_reason") @db.Text
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt                DateTime?              @map("revoked_at") @db.Timestamptz(6)
  organizationMembership   OrganizationMembership @relation(fields: [organizationMembershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roleDefinition           RoleDefinition         @relation(fields: [roleDefinitionId, roleScope], references: [id, scope], onDelete: Restrict, onUpdate: Restrict, map: "organization_role_assignment_role_definition_scope_fkey")

  @@index([organizationMembershipId])
  @@index([roleDefinitionId])
  @@map("organization_role_assignment")
  @@schema("core")
}

model CompanyRoleAssignment {
  id                  String            @id @default(uuid()) @db.Uuid
  companyMembershipId String            @db.Uuid
  roleDefinitionId    String            @db.Uuid
  roleScope           RoleScope         @default(COMPANY) @map("role_scope")
  grantActorUserId    String?           @map("grant_actor_user_id")
  isBreakGlass        Boolean           @default(false) @map("is_break_glass")
  breakGlassReason    String?           @map("break_glass_reason") @db.Text
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt           DateTime?         @map("revoked_at") @db.Timestamptz(6)
  companyMembership   CompanyMembership @relation(fields: [companyMembershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roleDefinition      RoleDefinition    @relation(fields: [roleDefinitionId, roleScope], references: [id, scope], onDelete: Restrict, onUpdate: Restrict, map: "company_role_assignment_role_definition_scope_fkey")

  @@index([companyMembershipId])
  @@index([roleDefinitionId])
  @@map("company_role_assignment")
  @@schema("core")
}

model PlantRoleAssignment {
  id                String          @id @default(uuid()) @db.Uuid
  plantAssignmentId String          @db.Uuid
  roleDefinitionId  String          @db.Uuid
  roleScope         RoleScope       @default(PLANT) @map("role_scope")
  grantActorUserId  String?         @map("grant_actor_user_id")
  isBreakGlass      Boolean         @default(false) @map("is_break_glass")
  breakGlassReason  String?         @map("break_glass_reason") @db.Text
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt         DateTime?       @map("revoked_at") @db.Timestamptz(6)
  plantAssignment   PlantAssignment @relation(fields: [plantAssignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roleDefinition    RoleDefinition  @relation(fields: [roleDefinitionId, roleScope], references: [id, scope], onDelete: Restrict, onUpdate: Restrict, map: "plant_role_assignment_role_definition_scope_fkey")

  @@index([plantAssignmentId])
  @@index([roleDefinitionId])
  @@map("plant_role_assignment")
  @@schema("core")
}

// Core validates these application references; no additional P05 FK edge is inferred.
model BreakGlassAccessAudit {
  id               String    @id @default(uuid()) @db.Uuid
  actorUserId      String    @map("actor_user_id")
  roleAssignmentId String    @db.Uuid @map("role_assignment_id")
  scope            RoleScope
  scopeParentId    String    @db.Uuid @map("scope_parent_id")
  reason           String    @db.Text
  occurredAt       DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([actorUserId, occurredAt])
  @@index([roleAssignmentId])
  @@index([scope, scopeParentId, occurredAt])
  @@map("break_glass_access_audit")
  @@schema("core")
}


enum DenyAuditEventType {
  POLICY_CREATED
  POLICY_REVOKED
  POLICY_READ
  POLICY_READ_DENIED
  POLICY_WRITE_DENIED
  POLICY_ENFORCEMENT_DENIED

  @@schema("core")
}

enum DenyAuditOutcome {
  SUCCESS
  DENIED
  FAILURE

  @@schema("core")
}

// Dedicated principal-bound DENY policy. It is intentionally separate from
// reusable RolePermissionGrant snapshots.
model TenantDenyPolicy {
  id                     String     @id @default(uuid()) @db.Uuid
  organizationId         String     @map("organization_id") @db.Uuid
  targetMembershipId     String     @map("target_membership_id") @db.Uuid
  targetUserId           String     @map("target_user_id")
  permissionDefinitionId String     @map("permission_definition_id") @db.Uuid
  scope                  RoleScope
  companyId              String?    @map("company_id") @db.Uuid
  plantId                String?    @map("plant_id") @db.Uuid
  reason                 String     @db.Text
  issuedByUserId         String     @map("issued_by_user_id")
  issuedAt               DateTime   @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt              DateTime?  @map("expires_at") @db.Timestamptz(6)
  revokedAt              DateTime?  @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId        String?    @map("revoked_by_user_id")
  revokeReason           String?    @map("revoke_reason") @db.Text

  targetMembership OrganizationMembership @relation(fields: [targetMembershipId, targetUserId, organizationId], references: [id, userId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  permissionDefinition PermissionDefinition @relation(fields: [permissionDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuer User @relation("TenantDenyPolicyIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revoker User? @relation("TenantDenyPolicyRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company Company? @relation("TenantDenyPolicyCompany", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  plant Plant? @relation("TenantDenyPolicyPlant", fields: [plantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  auditEvents TenantDenyAuditEvent[]

  @@index([organizationId, targetMembershipId, issuedAt])
  @@index([permissionDefinitionId])
  @@index([issuedByUserId, issuedAt])
  @@index([revokedByUserId, revokedAt])
  @@index([targetMembershipId, scope, companyId, plantId, permissionDefinitionId])
  @@map("tenant_deny_policy")
  @@schema("core")
}

// Append-only evidence for policy lifecycle and DENY-history read attempts.
// Nullable actor/target fields allow recording unauthenticated or malformed
// read attempts without trusting client-supplied identity.
model TenantDenyAuditEvent {
  id                     String              @id @default(uuid()) @db.Uuid
  policyId               String?             @map("policy_id") @db.Uuid
  organizationId         String?             @map("organization_id") @db.Uuid
  targetMembershipId     String?             @map("target_membership_id") @db.Uuid
  targetUserId           String?             @map("target_user_id")
  permissionDefinitionId String?             @map("permission_definition_id") @db.Uuid
  scope                  RoleScope?
  companyId              String?             @map("company_id") @db.Uuid
  plantId                String?             @map("plant_id") @db.Uuid
  actorUserId            String?             @map("actor_user_id")
  eventType              DenyAuditEventType  @map("event_type")
  outcome                DenyAuditOutcome
  reason                 String?             @db.Text
  reasonCode             String?             @map("reason_code") @db.VarChar(64)
  requestId              String?             @map("request_id") @db.VarChar(128)
  occurredAt             DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(6)

  policy TenantDenyPolicy? @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor User? @relation("TenantDenyAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissionDefinition PermissionDefinition? @relation(fields: [permissionDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, occurredAt])
  @@index([policyId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("tenant_deny_audit_event")
  @@schema("core")
}
