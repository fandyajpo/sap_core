# Local development only: point both variables to your disposable local database.
# Prisma Postgres credentials all have full database privileges; separate credentials
# provide secret lifecycle separation only, not database-level least privilege.
DATABASE_URL="postgresql://sap_core:sap_core_dev@localhost:5433/sap_core?schema=public"
MIGRATION_DATABASE_URL="postgresql://sap_core:sap_core_dev@localhost:5433/sap_core?schema=public"

BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"
